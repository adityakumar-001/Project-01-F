# Copy to .env and replace the passwords. Docker Compose reads this automatically.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
MYSQL_USER=attend
MYSQL_PASSWORD=replace-with-a-long-random-password

# Optional extra gate. Leave empty: bearer tokens are the real auth and this
# value would be visible to anyone using the browser app.
API_SECRET=

# Optional. Leave empty when this app serves the frontend itself (same origin).
CORS_ORIGIN=

# Local port on 127.0.0.1. Use a tunnel for public access, not port forwarding.
APP_PORT=3000

# Optional named Cloudflare Tunnel token (see README/deploy notes).
CLOUDFLARE_TUNNEL_TOKEN=
